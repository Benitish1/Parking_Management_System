# ============================================================
# XWZ Parking — Shared environment reference
# Copy the relevant values into each service's own .env file.
# Each microservice also ships its own .env.example.
# ============================================================

# ---- PostgreSQL (shared instance, one database) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parking_db
DB_USER=postgres
DB_PASSWORD=postgres

# ---- JWT (must be IDENTICAL across all services) ----
JWT_SECRET=super_secret_change_me_in_production_8f3a9c
JWT_EXPIRES_IN=1d

# ---- Service ports ----
GATEWAY_PORT=4000
AUTH_PORT=4001
USER_PORT=4002
PARKING_PORT=4003
CARENTRY_PORT=4004
REPORT_PORT=4005
NOTIFICATION_PORT=4006

# ---- Internal service URLs (service-to-service calls) ----
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
PARKING_SERVICE_URL=http://localhost:4003
CARENTRY_SERVICE_URL=http://localhost:4004
REPORT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006

# ---- CORS (frontend origin) ----
CLIENT_URL=http://localhost:5173

# ---- SMTP for OTP email (Notification service) ----
# For Gmail: create an App Password. For dev, leave blank to log OTPs to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XWZ Parking <no-reply@xwzparking.rw>"
